# Append to the Supabase project's .env (after running upstream setup.sh,
# which generates the database password, JWT secret and API keys).
# Never commit the filled-in file.

############
# Upstream settings Peak needs changed from their defaults
############
# COMPOSE_FILE=docker-compose.yml:docker-compose.peak.yml   (sh run.sh config add peak)
# SUPABASE_PUBLIC_URL=https://api.peak.example.com
# API_EXTERNAL_URL=https://api.peak.example.com/auth/v1
# SITE_URL=https://peak.example.com
# DISABLE_SIGNUP=true            accounts are created by the admin, never self-serve
# ENABLE_EMAIL_SIGNUP=true       keeps the email provider on; sign-in codes need it
# ENABLE_PHONE_SIGNUP=false
# FUNCTIONS_VERIFY_JWT=false     two functions authenticate with their own shared secret

############
# Peak
############

# Caddy site addresses. Bare hostnames get automatic HTTPS (needs 80/443
# forwarded); prefix with http:// when a Cloudflare Tunnel terminates TLS.
PEAK_APP_SITE=
PEAK_API_SITE=

# Where Studio (via the gateway on :8000) is published. Loopback means SSH
# tunnel only; a LAN address makes it reachable on the home network.
STUDIO_BIND_ADDRESS=127.0.0.1

# Edge Function secrets. NOTIFY_TRIGGER_SECRET and REST_PUSH_SECRET must match
# the Vault secrets account_request_notify_service_role and
# rest_push_trigger_secret (docs/self-hosting.md, "Database").
RESEND_API_KEY=
NOTIFY_TRIGGER_SECRET=
REST_PUSH_SECRET=

# Reuse the hosted project's pair so existing push subscriptions stay valid.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Only with the `tunnel` profile.
CLOUDFLARE_TUNNEL_TOKEN=
