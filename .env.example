# Real Supabase project — required for auth and cross-device sync.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to 1 to skip AuthScreen and use the app directly against local
# IndexedDB data, without a real Supabase project configured. Dev-only —
# has no effect on a production build. See LOCAL_PREVIEW in src/App.tsx.
VITE_LOCAL_PREVIEW=0

# Web Push public key (base64url, uncompressed P-256 point). Enables the rest
# alert reaching a phone whose screen is off. Leave blank and the whole push
# path stays inert — the app behaves exactly as it did without it.
#
# Generate a pair with:  npx web-push generate-vapid-keys
# The PUBLIC half goes here and ships in the bundle, which is fine and by
# design. The PRIVATE half is a secret and belongs only in the Edge Function
# (see docs/rest-push.md) — never in this file, never in the client.
VITE_VAPID_PUBLIC_KEY=
